{
  "name": "nebula-node-server",
  "version": "1.0.0",
  "description": "Node.js server for Nebula Notebook (terminals, filesystem, kernels, LLM)",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "node --watch --import tsx src/index.ts",
    "auth:qr": "tsx src/scripts/show-auth-qr.ts",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/multipart": "^9.4.0",
    "@fastify/static": "^9.0.0",
    "@fastify/websocket": "^11.2.0",
    "@homebridge/node-pty-prebuilt-multiarch": "^0.14.0",
    "@simplewebauthn/server": "^13.3.3",
    "better-sqlite3": "^11.0.0",
    "fastify": "^5.8.2",
    "jsonwebtoken": "^9.0.2",
    "nebula-autocomplete": "file:../packages/autocomplete",
    "otplib": "^12.0.1",
    "qrcode-terminal": "^0.12.0",
    "uuid": "^9.0.1",
    "ws": "^8.16.0",
    "yaml": "^2.9.0",
    "zeromq": "^6.4.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.8",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.0",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^9.0.7",
    "@types/ws": "^8.5.10",
    "supertest": "^7.2.2",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vitest": "^4.0.16"
  }
}
